# Supabase Project Settings -> API. Never expose service role key to browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated email addresses allowed into /admin
ADMIN_EMAILS=you@yourdomain.com

# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Create a separate webhook secret in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=YOUR_SEPARATE_WEBHOOK_SECRET

# Public origin with https in production, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
